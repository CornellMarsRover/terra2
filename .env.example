# Jetson SSH auth for scripts/astrotech_hub.py (cmr@192.168.1.69).
#
# PREFERRED: use an SSH key instead of a password -- run this once:
#     ssh-copy-id cmr@192.168.1.69
# Then leave JETSON_SSH_PASSWORD blank below; the hub uses your key and stores
# no secret anywhere.
#
# FALLBACK (convenience): put the password here so you don't retype it. This
# file is gitignored -- never commit it. Lock it down: chmod 600 .env
#     cp .env.example .env   &&   edit .env   &&   chmod 600 .env
JETSON_SSH_PASSWORD=
