<?xml version="1.0"?>
<robot name="drives">
  <link name="base_link">
    <visual>
      <origin xyz="-0.410805 -0.322049 1.01346" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///cmr/terra2/meshes/rover_26.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="rover_orange">
        <color rgba="0.92 0.45 0.12 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <geometry>
        <box size="1.08 0.50 0.34"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <mass value="45.0"/>
      <inertia ixx="4.0" ixy="0.0" ixz="0.0" iyy="10.0" iyz="0.0" izz="12.0"/>
    </inertial>
  </link>

  <gazebo>
    <plugin filename="libgazebo_ros_planar_move.so" name="drives_planar_move">
      <ros>
        <namespace>/drives</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>60</update_rate>
      <publish_rate>20</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <sensor name="camera1" type="camera">
      <update_rate>30.0</update_rate>
      <camera name="head_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>800</width>
          <height>800</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>50.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <plugin filename="libgazebo_ros_camera.so" name="camera_controller">
        <camera_name>camera1</camera_name>
        <frame_name>base_link</frame_name>
      </plugin>
      <pose>0 0 0.95 0 0 0</pose>
    </sensor>
  </gazebo>
</robot>
