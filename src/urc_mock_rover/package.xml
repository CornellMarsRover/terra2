<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>urc_mock_rover</name>
    <version>0.1.0</version>
    <description>
        Mock rover for URC 2026 Astrotech GCS development.
        Publishes every topic / advertises every service+action from
        astrotech_interfaces.yaml without requiring rover hardware. See
        docs/phase2a_assumptions.md for what's real vs. placeholder.
    </description>
    <maintainer email="team@cornellmarsrover.org">CMR</maintainer>
    <license>MIT</license>

    <exec_depend>rclpy</exec_depend>
    <exec_depend>std_msgs</exec_depend>
    <exec_depend>cmr_msgs</exec_depend>
    <exec_depend>python3-yaml</exec_depend>
    <exec_depend>python3-numpy</exec_depend>
    <exec_depend>ros2launch</exec_depend>
    <exec_depend>foxglove_bridge</exec_depend>

    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
