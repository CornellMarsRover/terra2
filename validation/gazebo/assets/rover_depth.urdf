<?xml version="1.0"?>
<robot name="drives">
  <link name="base_link">
    <visual><origin xyz="-0.410805 -0.44323 -0.073884" rpy="1.57079632679 0 0"/><geometry><mesh filename="file:///cmr/terra2/meshes/rover_26.stl" scale="0.001 0.001 0.001"/></geometry><material name="orange"><color rgba="0.92 0.45 0.12 1"/></material></visual>
    <collision><origin xyz="0 0 0.17"/><geometry><box size="1.08 1.14 0.34"/></geometry></collision>
    <inertial><origin xyz="0 0 0.17"/><mass value="45"/><inertia ixx="4" ixy="0" ixz="0" iyy="10" iyz="0" izz="12"/></inertial>
  </link>
  <gazebo>
    <plugin filename="libgazebo_ros_planar_move.so" name="drives_planar_move">
      <ros><namespace>/drives</namespace></ros><update_rate>60</update_rate><publish_rate>20</publish_rate>
      <publish_odom>true</publish_odom><publish_odom_tf>false</publish_odom_tf>
      <odometry_frame>odom</odometry_frame><robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="camera" type="depth">
      <pose>0.4 0 1.0 0 0 0</pose><update_rate>10</update_rate><always_on>true</always_on><visualize>true</visualize>
      <camera><horizontal_fov>1.91986217719</horizontal_fov><image><width>80</width><height>60</height><format>B8G8R8</format></image><depth_camera/><clip><near>0.3</near><far>6.0</far></clip></camera>
      <plugin filename="libgazebo_ros_camera.so" name="depth_camera_controller">
        <camera_name>camera</camera_name><frame_name>camera_link</frame_name><min_depth>0.3</min_depth><max_depth>6.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
</robot>
