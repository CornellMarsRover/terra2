#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
usage() {
  cat <<'HELP'
Usage: ./run MODE
  setup       Install ROS package dependencies
  gesture-setup  Install Ultralytics and download the pose model
  build       Build driving and autonomy packages
  teleop      Start controller receiver and rover drive hardware
  controller  Send input; add `setup` once on the laptop
  auto        Start hardware autonomy and rover drive hardware
  gesture     Start human gesture detection separately
  sim         Start autonomy with simulated sensor inputs
  test        Run focused autonomy tests
  help        Show this guide
HELP
}
mode="${1:-help}"
shift || true
case "$mode" in
  help|-h|--help) usage; exit 0 ;;
  controller)
    cd "local_(no ROS)base_station_scripts"
    if [[ ${1:-} == setup ]]; then shift; exec python3 -m pip install -r requirements.txt "$@"; fi
    exec python3 drive_control.py "$@"
    ;;
  gesture-setup)
    python3 -m pip install -r src/cmr_zed/requirements.txt "$@"
    (
      cd src/cmr_zed/config
      python3 -c 'from ultralytics import YOLO; YOLO("yolo26n-pose.pt")'
    )
    if [[ ! -f src/cmr_zed/config/yolo26n-pose.pt ]]; then
      echo "Ultralytics did not place yolo26n-pose.pt in src/cmr_zed/config." >&2
      exit 1
    fi
    echo "Gesture prerequisites ready. Run: ./run build"
    exit 0
    ;;
  test)
    python3 -c "import coverage, pytest" 2>/dev/null || {
      echo "Test tools missing. Run: python3 -m pip install coverage pytest" >&2
      exit 1
    }
    exec bash scripts/test_autonomy.sh "$@"
    ;;
  build|setup|teleop|auto|gesture|sim) ;;
  *) echo "Unknown mode: $mode" >&2; usage >&2; exit 2 ;;
esac
if [[ ! -f /opt/ros/humble/setup.bash ]]; then
  echo "ROS 2 Humble is required. Run this on the Jetson or in the dev container." >&2
  exit 1
fi
set +u
source /opt/ros/humble/setup.bash
set -u
if [[ "$mode" == setup ]]; then
  [[ -f /etc/ros/rosdep/sources.list.d/20-default.list ]] || sudo rosdep init
  rosdep update
  paths=(src/{cmr_msgs,cmr_utils,cmr_fabric,cmr_controller_remote,cmr_rovernet,cmr_zed,autonomous_navigation})
  exec rosdep install --from-paths "${paths[@]}" --ignore-src -r -y "$@"
fi
if [[ "$mode" == build ]]; then
  exec colcon build --symlink-install --packages-up-to \
    cmr_fabric cmr_controller_remote cmr_rovernet cmr_zed autonomous_navigation "$@"
fi
if [[ ! -f install/setup.bash ]]; then
  echo "Workspace is not built. Run: ./run build" >&2
  exit 1
fi
set +u
source install/setup.bash
set -u
case "$mode" in
  teleop) exec ros2 launch cmr_rovernet rovernet.launch.py enable_arm:=false "$@" ;;
  auto) exec ros2 launch autonomous_navigation localization_real.launch.py "$@" ;;
  gesture) exec bash scripts/run_human_gesture_detection.sh "$@" ;;
  sim) exec ros2 launch autonomous_navigation sim_autonomy.launch.py "$@" ;;
esac
