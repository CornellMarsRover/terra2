{
  "name": "Terra",
  "image": "cornellmarsrover/dev:latest",
  "mounts": [
    "source=${localWorkspaceFolder}/..,target=/cmr,type=bind",
    "source=${env:HOME}/.ssh,target=/home/cmr/.ssh,type=bind"
  ],
  "workspaceFolder": "/cmr/terra2",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "eamodio.gitlens",
        "ms-iot.vscode-ros",
        "twxs.cmake",
        "smilerobotics.urdf",
        "redhat.vscode-yaml",
        "ms-vscode.cmake-tools",
        "bungcip.better-toml",
        "codezombiech.gitignore",
        "llvm-vs-code-extensions.vscode-clangd",
        "DotJoshJohnson.xml",
        "cschlosser.doxdocgen",
        "xaver.clang-format",
        // "notskm.clang-tidy", just use clang-tidy from clangd
        "matepek.vscode-catch2-test-adapter",
        "Gruntfuggly.todo-tree",
        "kevinkyang.auto-comment-blocks",
        "josetr.cmake-language-support-vscode"
      ]
    }
  },
  "containerEnv": {
    "DISPLAY": "host.docker.internal:0",
    "TERRA_GUI_MODE": "xpra",
    "TERRA_XPRA_DISPLAY": ":0",
    "TERRA_XQUARTZ_DISPLAY": "host.docker.internal:0"
  },
  "runArgs": [
    "--platform=linux/amd64",
    "-p=14500:14500",
    "-p=5010:5010/udp",
    "-p=5020:5020/udp",
    "-p=5030:5030/udp",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp:unconfined",
    "--security-opt=apparmor:unconfined",
    "--volume=/tmp/.X11-unix:/tmp/.X11-unix"
  ]
  // X11 can be set up with https://gist.github.com/paul-krohn/e45f96181b1cf5e536325d1bdee6c949
}
