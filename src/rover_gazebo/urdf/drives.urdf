<?xml version="1.0"?>
<robot name="drives">
  <link name="base_link">
    <visual>
      <origin xyz="-0.410805 -0.44323 -0.073884" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="file:///cmr/terra2/src/rover_gazebo/meshes/rover_26.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="rover_orange_ghost">
        <color rgba="0.92 0.45 0.12 0.55"/>
      </material>
    </visual>

    <visual>
      <origin xyz="0 0 0.29" rpy="0 0 0"/>
      <geometry>
        <box size="0.90 0.98 0.18"/>
      </geometry>
      <material name="chassis_dark">
        <color rgba="0.17 0.17 0.19 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.29" rpy="0 0 0"/>
      <geometry>
        <box size="0.92 1.00 0.20"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.29" rpy="0 0 0"/>
      <mass value="45.0"/>
      <inertia ixx="4.0" ixy="0.0" ixz="0.0" iyy="10.0" iyz="0.0" izz="12.0"/>
    </inertial>
  </link>

  <link name="front_left_steer_link">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.09"/>
      </geometry>
      <material name="module_dark">
        <color rgba="0.12 0.12 0.12 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>
  <joint name="front_left_steer_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_steer_link"/>
    <origin xyz="0.415 0.415 0.13" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="front_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.13" length="0.07"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.03 0.03 0.03 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.004" ixy="0.0" ixz="0.0" iyy="0.004" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_steer_link">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.09"/>
      </geometry>
      <material name="module_dark"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>
  <joint name="front_right_steer_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_steer_link"/>
    <origin xyz="0.415 -0.415 0.13" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="front_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.13" length="0.07"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.004" ixy="0.0" ixz="0.0" iyy="0.004" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="back_left_steer_link">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.09"/>
      </geometry>
      <material name="module_dark"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>
  <joint name="back_left_steer_joint" type="continuous">
    <parent link="base_link"/>
    <child link="back_left_steer_link"/>
    <origin xyz="-0.415 0.415 0.13" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="back_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.13" length="0.07"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.004" ixy="0.0" ixz="0.0" iyy="0.004" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>
  <joint name="back_left_wheel_joint" type="continuous">
    <parent link="back_left_steer_link"/>
    <child link="back_left_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="back_right_steer_link">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.09"/>
      </geometry>
      <material name="module_dark"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>
  <joint name="back_right_steer_joint" type="continuous">
    <parent link="base_link"/>
    <child link="back_right_steer_link"/>
    <origin xyz="-0.415 -0.415 0.13" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="back_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.13" length="0.07"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.004" ixy="0.0" ixz="0.0" iyy="0.004" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>
  <joint name="back_right_wheel_joint" type="continuous">
    <parent link="back_right_steer_link"/>
    <child link="back_right_wheel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <gazebo>
    <plugin filename="libgazebo_ros_planar_move.so" name="drives_planar_move">
      <ros>
        <namespace>/drives</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>100</update_rate>
      <publish_rate>30</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>

    <plugin name="gazebo_ros_joint_pose_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
      <ros>
        <namespace>/drives</namespace>
        <remapping>set_joint_trajectory:=joint_trajectory_cmd</remapping>
      </ros>
      <update_rate>60</update_rate>
    </plugin>

    <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/drives</namespace>
        <remapping>joint_states:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>front_left_steer_joint</joint_name>
      <joint_name>front_right_steer_joint</joint_name>
      <joint_name>back_left_steer_joint</joint_name>
      <joint_name>back_right_steer_joint</joint_name>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>back_left_wheel_joint</joint_name>
      <joint_name>back_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <sensor name="camera1" type="camera">
      <update_rate>30.0</update_rate>
      <camera name="head_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>800</width>
          <height>800</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>50.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <plugin filename="libgazebo_ros_camera.so" name="camera_controller">
        <camera_name>camera1</camera_name>
        <frame_name>base_link</frame_name>
      </plugin>
      <pose>0 0 1.05 0 0 0</pose>
    </sensor>
  </gazebo>
</robot>
