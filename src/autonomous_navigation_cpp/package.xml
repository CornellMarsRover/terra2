<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autonomous_navigation_cpp</name>
  <version>0.0.1</version>
  <description>C++ port of autonomous_navigation (state machine, costmap, local planner, controller, Kalman localization)</description>
  <maintainer email="cmravocado@gmail.com">avocado</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>class_loader</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml_cpp_vendor</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>cmr_msgs</depend>
  <depend>eigen</depend>
  <!-- state_machine reads its waypoint YAMLs from this package's share dir -->
  <exec_depend>autonomous_navigation</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
