<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cmr_imu_cpp</name>
  <version>0.0.0</version>
  <description>C++ port of cmr_imu (imu_node + WitMotion JY901S RS485 protocol stack). Drop-in replacement: same executable, node, topic and message names.</description>
  <maintainer email="team@cornellmarsrover.org">CMR</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>cmr_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
