<?xml version="1.0"?>
<sdf version="1.6"><world name="stress_course">
  <include><uri>model://ground_plane</uri></include><include><uri>model://sun</uri></include>
  <physics type="ode"><real_time_update_rate>500</real_time_update_rate></physics>
  <gui><camera name="overview"><pose>-7 -11 16 0 0.72 0.62</pose><view_controller>orbit</view_controller></camera></gui>
  <model name="round_boulder"><static>true</static><pose>2.2 0 0.55 0 0 0</pose><link name="link">
