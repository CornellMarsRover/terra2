<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cmr_zed_cpp</name>
  <version>0.0.0</version>
  <description>
    C++ (rclcpp_components) port of cmr_zed: zed_publisher_node, zed_autonomy, threaded.
    Requires the Stereolabs ZED SDK 4.x (not a rosdep key); without it the package builds nothing.
  </description>
  <maintainer email="aks237@cornell.edu">cmr</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cmr_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>libopencv-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
